{
    "name": "vibe-break",
    "version": "0.1.0",
    "description": "A corner mini-game for the dead time while AI generates code",
    "main": "src/main.js",
    "scripts": {
        "start": "electron .",
        "build": "electron-builder --mac",
        "build:win": "electron-builder --win",
        "build:all": "electron-builder -mw"
    },
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "electron": "^31.0.0",
        "electron-builder": "^24.13.3"
    },
    "build": {
        "appId": "com.you.vibebreak",
        "productName": "Vibe Break",
        "mac": {
            "category": "public.app-category.games",
            "target": {
                "target": "dmg",
                "arch": "universal"
            }
        },
        "win": {
            "target": [
                { "target": "nsis", "arch": ["x64"] },
                { "target": "portable", "arch": ["x64"] }
            ]
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true
        },
        "files": [
            "src/**/*",
            "package.json"
        ]
    }
}